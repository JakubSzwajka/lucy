{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://mlp.dev/schemas/continuity/v1/memory-types.schema.json",
  "title": "Continuity Memory Types",
  "description": "Schema for structured memory extraction in the Continuity Framework",
  "definitions": {
    "memoryType": {
      "type": "string",
      "enum": ["fact", "preference", "relationship", "principle", "commitment", "moment", "skill"],
      "description": "Classification of memory content"
    },
    "memory": {
      "type": "object",
      "required": ["id", "type", "content", "tags", "source_turn"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^mem_[a-f0-9-]+$",
          "description": "Unique memory identifier"
        },
        "type": {
          "$ref": "#/definitions/memoryType"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "The extracted memory content"
        },
        "source_quote": {
          "type": "string",
          "description": "Direct quote from conversation if available"
        },
        "source_turn": {
          "type": "string",
          "description": "Identifier of the conversation turn this memory was extracted from (e.g., 'user message 3')"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "minItems": 0,
          "maxItems": 10,
          "description": "Tags for categorization and retrieval"
        },
        "context": {
          "type": "string",
          "description": "Brief context about when/why this was stated"
        },
        "uncertain": {
          "type": "boolean",
          "default": false,
          "description": "Flag indicating classification uncertainty"
        },
        "uncertainty_reason": {
          "type": "string",
          "description": "Reason for uncertainty if flagged"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of extraction"
        },
        "session_id": {
          "type": "string",
          "description": "ID of session this memory was extracted from"
        },
        "valid_from": {
          "type": "string",
          "format": "date",
          "description": "ISO date when this memory became valid"
        },
        "valid_until": {
          "type": ["string", "null"],
          "format": "date",
          "description": "ISO date when this memory was superseded (null if still valid)"
        },
        "still_valid": {
          "type": "boolean",
          "default": true,
          "description": "Whether this memory is currently valid"
        },
        "supersedes": {
          "type": ["string", "null"],
          "description": "ID of the memory this supersedes (null if original)"
        },
        "confabulation_risk": {
          "type": "boolean",
          "default": false,
          "description": "Whether this memory failed confabulation check"
        },
        "confabulation_reason": {
          "type": "string",
          "enum": ["no_source_quote", "source_quote_not_found"],
          "description": "Reason for confabulation flag"
        },
        "salience": {
          "type": "object",
          "properties": {
            "importance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "How significant to ongoing existence (0-1)"
            },
            "novelty": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "How unexpected or surprising (0-1)"
            },
            "affect_heuristic": {
              "type": "object",
              "properties": {
                "valence": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1,
                  "description": "Negative to positive emotional tone (-1 to 1)"
                },
                "arousal": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Activation level (0-1)"
                }
              },
              "description": "Affect heuristic for retrieval weighting (NOT phenomenological)"
            }
          },
          "description": "Salience dimensions for retrieval weighting"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["memories", "extraction_metadata"],
  "properties": {
    "memories": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/memory"
      },
      "description": "Array of extracted memories"
    },
    "extraction_metadata": {
      "type": "object",
      "required": ["messages_analyzed", "memories_extracted"],
      "properties": {
        "messages_analyzed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of messages analyzed"
        },
        "memories_extracted": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of memories successfully extracted"
        },
        "skipped_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Reasons why potential memories were skipped"
        },
        "extraction_time_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Time taken to extract memories in milliseconds"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
